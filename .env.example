# =========================
# Application
# =========================
HOST=0.0.0.0
PORT=8080

# =========================
# PostgreSQL
# =========================
DB_HOST=patisserie-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=patisserie_db
DB_SSL_MODE=disable

# =========================
# MinIO
# =========================
MINIO_ENDPOINT=patisserie-minio:9000
ACCESS_KEY_ID=admin
SECRET_ACCESS_KEY=admin123
USE_SSL=false
BUCKET_NAME=patisserie-images
BUCKET_POLICY=public

# =========================
# Redis
# =========================
REDIS_ADDR=patisserie-redis:6379
REDIS_EXPIRATION=5m

# =========================
# JWT
# =========================
ACCESS_SECRET=change_me_access_secret
ACCESS_EXPIRATION=15m

REFRESH_SECRET=change_me_refresh_secret
REFRESH_EXPIRATION=7d